# ─── AI (optional) ─────────────────────────────────────────────
# Without a key the app runs in DEMO MODE with pre-built sample trips.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. claude-haiku-5-5 is ~40x cheaper per trip.
ANTHROPIC_MODEL=claude-opus-5-5
# Hard cap on AI generations per day across all visitors (protects your bill).
AI_DAILY_LIMIT=50
# Per-visitor AI requests per hour.
AI_HOURLY_LIMIT_PER_IP=5

# ─── Supabase (optional locally, required for auth/saving/realtime) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "true" after enabling Google in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Public URL of the deployed site (used for share links and OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
